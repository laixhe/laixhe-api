APP_NAME=WebApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webapi
DB_USERNAME=root
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 缓存驱动 (默认 file)。生产环境强烈建议设为 redis:
# 1) 限流/健康检查/雪花ID共用缓存, file 驱动下会累积大量永不清理的小文件且每请求一次磁盘IO;
# 2) 限流的"读-改-写"在 redis 下配合原子 INCR 才能在高并发下计数准确。
CACHE_STORE=file

# JWT 密钥 (生产环境务必修改; 与 Go 端 config.yaml 保持一致可让两端 token 互通)
JWT_SECRET=6Kbj0VFeXYMp60lEyiFoVq4UzqX8Z0GSSfnvTh2VuAQn0oHgQNYexU6yYVTk4xf9
JWT_EXPIRE_TIME=2592000

# Snowflake ID 生成 (多实例部署时须为各实例分配不同的 datacenter/worker 组合, 范围 0-31; -1 表示随机)
SNOWFLAKE_DATACENTER=-1
SNOWFLAKE_WORKER=-1

# 接口限流 (与 Go 端 config.yaml limit 对齐)
RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60

# 请求超时时间(秒), 预留配置 (对齐 Go/Rust 端 http.timeout: 30):
# 当前框架未实现超时中间件, 该值暂未生效; 生产环境请求超时应由 Nginx 等服务器层配置
HTTP_TIMEOUT=30

LOG_CHANNEL=daily
#error info debug
LOG_LEVEL=debug
