APP_NAME=WebApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webapi
DB_USERNAME=root
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# JWT 密钥 (生产环境务必修改; 与 Go 端 config.yaml 保持一致可让两端 token 互通)
JWT_SECRET=6Kbj0VFeXYMp60lEyiFoVq4UzqX8Z0GSSfnvTh2VuAQn0oHgQNYexU6yYVTk4xf9
JWT_EXPIRE_TIME=2592000

# 接口限流 (与 Go 端 config.yaml limit 对齐)
RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60

LOG_CHANNEL=daily
#error info debug
LOG_LEVEL=debug
