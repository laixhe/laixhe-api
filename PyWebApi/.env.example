# 服务监听
HOST=0.0.0.0
PORT=6600
# 请求超时时间(秒), 超时返回 408
HTTP_TIMEOUT=30

# 数据库连接串 (默认 mysql; 切换 sqlite 示例: sqlite:///./pywebapi.db)
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/webapi?charset=utf8mb4

# JWT (生产环境务必修改密钥)
JWT_SECRET_KEY=6Kbj0VFeXYMp60lEyiFoVq4UzqX8Z0GSSfnvTh2VuAQn0oHgQNYexU6yYVTk4xf9
JWT_SIGNING_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=2592000

# 接口限流 (单 IP 滑动窗口)
LIMIT_ENABLE=true
LIMIT_MAX=1000
LIMIT_WINDOW=60
