# 数据库连接（MariaDB/MySQL）
DATABASE_URL="mysql://root:password@127.0.0.1:3306/webapi?charset=utf8mb4"

# JWT 签名密钥（生产环境务必修改为强随机字符串）
JWT_SECRET_KEY="change-me-to-a-random-secret-key"

# JWT Token 过期时间（秒），默认 30 天
JWT_EXPIRE_TIME="2592000"

# HTTP 服务监听地址
HTTP_IP="0.0.0.0"

# HTTP 服务监听端口
HTTP_PORT="6600"

# 日志级别：debug | info | warn | error
LOG_LEVEL="debug"

# 数据库连接池大小（默认 10）
# POOL_SIZE="10"
